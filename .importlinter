[importlinter]
root_packages =
    lspr_core
    lspr_io
    lspr_ui
    lspr_imaging_app
include_external_packages = True

[importlinter:contract:core-no-gui]
name = lspr_core stays free of GUI/Qt dependencies
type = forbidden
source_modules =
    lspr_core
forbidden_modules =
    PyQt6
    PySide6
    lspr_ui

[importlinter:contract:io-no-gui]
name = lspr_io stays free of GUI/Qt dependencies
type = forbidden
source_modules =
    lspr_io
forbidden_modules =
    PyQt6
    PySide6
    lspr_ui

# ---------------------------------------------------------------------------
# LSPRi Evaluation (apps/LSPRi/eva). Written 2026-11-02 from the measured imports, see
# apps/LSPRi/eva/docs/maintainability_audit_2026-11-01.md and docs/import_layering_2026-11-02.md there.
#
# Layers, top to bottom: a package may import from the layers BELOW it, never from above.
# "a | b" = two packages on the same layer that must not import each other.
# "exhaustive": a new top-level package or module must be given a layer here, or this contract fails.
# ---------------------------------------------------------------------------
[importlinter:contract:lspri-layers]
name = LSPRi Evaluation layers: imports only point downwards
type = layers
containers =
    lspr_imaging_app
exhaustive = True
layers =
    app_rewrite
    launch | startup_tracker | gui | perf_setup | roi_geometry_sync
    panels
    selection
    dataset
    io
    storage
    analysis
    roi
    image_tools
    plan
    threaded_task | diagnostics | gil_tuning | version
    progress | applog | format_versions | undo | thread_priority | shortcuts | change_events | wavelength_color | image_features | domain | processing
# KNOWN EXCEPTIONS (16 imports that point upwards today). They are the debt, not the rule: every line
# below is a fix waiting to be done. When one is fixed, delete its line (import-linter FAILS on a line
# that no longer matches an import, so the list can only shrink).
ignore_imports =
# ROI data (roi/model.py: AreaRoi, AreaRoiDetectionSettings) and ignored_pixel_mask (roi/detection.py)
# sit above image_tools but are used by it. Fix: move the plain ROI data classes and that one helper
# below image_tools (the ROI code that really needs image_tools, rasterize/toolbox, stays above).
    lspr_imaging_app.image_tools.preprocess -> lspr_imaging_app.roi.model
    lspr_imaging_app.image_tools.chromatic.affine -> lspr_imaging_app.roi.model
    lspr_imaging_app.image_tools.background.estimate -> lspr_imaging_app.roi.model
    lspr_imaging_app.image_tools.background.estimate -> lspr_imaging_app.roi.detection
# roi_feature_task.py is ROI-feature orchestration (dataset + three roi modules) living in image_tools.
# Fix: move it up to roi/ (or panels/), where it is not an upward import.
    lspr_imaging_app.image_tools.roi_feature_task -> lspr_imaging_app.dataset
    lspr_imaging_app.image_tools.roi_feature_task -> lspr_imaging_app.roi.model
    lspr_imaging_app.image_tools.roi_feature_task -> lspr_imaging_app.roi.rasterize
    lspr_imaging_app.image_tools.roi_feature_task -> lspr_imaging_app.roi.toolbox
# Mask export needs FrameNamingScheme (a small file-naming class) from analysis/provenance.py.
# Fix: move FrameNamingScheme to a layer below image_tools. This is also the only thing that makes
# the four image tools look dependent on each other (see the independence contract below).
    lspr_imaging_app.image_tools.mask.export -> lspr_imaging_app.analysis.provenance
    lspr_imaging_app.image_tools.mask_export_task -> lspr_imaging_app.analysis.provenance
# The scan reads planes with dataset/io.py's load_image_array_uncached, while dataset sits above analysis
# (dataset/module.py uses AnalysisWorker from analysis/worker.py; dataset/io.py uses storage/workspace.py).
# Fix, simplest first: pass the plane loader into the scan as a callable (ScanSource already carries
# callables); or move worker.py and storage/workspace.py down so that analysis can sit above dataset.
    lspr_imaging_app.analysis.scan -> lspr_imaging_app.dataset.io
# The Zarr export worker process calls dataset/io.py's private helper _ome_zarr_root. Fix: move that
# helper down into io/ (or pass the root in).
    lspr_imaging_app.io._zarr_export_worker -> lspr_imaging_app.dataset.io
# PlanModule (a Qt module) needs the dataset and the step statistics, while other plan files are
# data-only and used from below. Fix: split plan/ into plan data (low) and PlanModule (high).
    lspr_imaging_app.plan.module -> lspr_imaging_app.analysis.step_stats
    lspr_imaging_app.plan.module -> lspr_imaging_app.dataset.module
# Session writing needs two small data classes from layers above it (ExportStats, FrameRolesState).
# Fix: move them down next to storage, or pass the values in as arguments.
    lspr_imaging_app.storage.session_carry_task -> lspr_imaging_app.dataset.export_stats
    lspr_imaging_app.storage.session -> lspr_imaging_app.selection.frame_roles_state

# The four image tools are documented as independent modules (apps/LSPRi/eva/CLAUDE.md, "Module
# boundaries"). They are, apart from one indirect chain through analysis/provenance.py (the FrameNamingScheme
# exception above), independent.
[importlinter:contract:lspri-image-tools-independent]
name = LSPRi Evaluation: geometry, mask, chromatic and background do not import each other
type = independence
modules =
    lspr_imaging_app.image_tools.geometry
    lspr_imaging_app.image_tools.mask
    lspr_imaging_app.image_tools.chromatic
    lspr_imaging_app.image_tools.background
ignore_imports =
    lspr_imaging_app.image_tools.mask.export -> lspr_imaging_app.analysis.provenance
