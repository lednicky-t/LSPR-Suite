[importlinter]
root_packages =
    lspr_core
    lspr_io
    lspr_ui
    lspr_imaging_app
include_external_packages = True

[importlinter:contract:core-no-gui]
name = lspr_core stays free of GUI/Qt dependencies
type = forbidden
source_modules =
    lspr_core
forbidden_modules =
    PyQt6
    PySide6
    lspr_ui

[importlinter:contract:io-no-gui]
name = lspr_io stays free of GUI/Qt dependencies
type = forbidden
source_modules =
    lspr_io
forbidden_modules =
    PyQt6
    PySide6
    lspr_ui

# ---------------------------------------------------------------------------
# LSPRi Evaluation (apps/LSPRi/eva). Written 2026-11-02 from the measured imports, see
# apps/LSPRi/eva/docs/maintainability_audit_2026-11-01.md and docs/import_layering_2026-11-02.md there.
#
# Layers, top to bottom: a package may import from the layers BELOW it, never from above.
# "a | b" = two packages on the same layer that must not import each other.
# "exhaustive": a new top-level package or module must be given a layer here, or this contract fails.
# ---------------------------------------------------------------------------
[importlinter:contract:lspri-layers]
name = LSPRi Evaluation layers: imports only point downwards
type = layers
containers =
    lspr_imaging_app
exhaustive = True
layers =
    app_rewrite
    launch | startup_tracker | gui | perf_setup | roi_geometry_sync
    panels
    selection
    dataset
    io
    storage
    analysis
    roi
    image_tools
    plan
    threaded_task | diagnostics | gil_tuning | version | plane_reader
    progress | applog | format_versions | shard_crc | frame_naming | export_stats | frame_roles_state | undo | thread_priority | shortcuts | change_events | wavelength_color | image_features | domain | processing
# No known exceptions (2026-11-02: the last upward imports were fixed). A new one fails the build: move what you need down or pass it in;
# do not add an `ignore_imports` line without the maintainer's agreement (see apps/LSPRi/eva/docs/import_layering_2026-11-02.md).

# The four image tools are documented as independent modules (apps/LSPRi/eva/CLAUDE.md, "Module
# boundaries"). They are independent (the one chain between them, through FrameNamingScheme in
# analysis/provenance.py, was removed on 2026-11-02 by moving it to frame_naming.py).
[importlinter:contract:lspri-image-tools-independent]
name = LSPRi Evaluation: geometry, mask, chromatic and background do not import each other
type = independence
modules =
    lspr_imaging_app.image_tools.geometry
    lspr_imaging_app.image_tools.mask
    lspr_imaging_app.image_tools.chromatic
    lspr_imaging_app.image_tools.background

# ---------------------------------------------------------------------------
# Pure-science modules stay free of Qt, even through other modules (root CLAUDE.md: "Keep science out of GUI code. Analysis functions must
# work without a running Qt application"). The list is the modules of analysis, roi, image_tools, plan and domain, and the plane
# readers, that reach no Qt today (measured 2026-11-02). They import and test without a QApplication and a worker process loads no Qt.
# A module that needs Qt does not belong here: keep its calculation in a Qt-free file and give the Qt part its own. Add a new pure module
# to the list when you write one; do not remove one without asking.
# ---------------------------------------------------------------------------
[importlinter:contract:lspri-science-no-qt]
name = LSPRi Evaluation: pure-science modules do not import Qt (not even through other modules)
type = forbidden
source_modules =
    lspr_imaging_app.domain
    lspr_imaging_app.plan
    lspr_imaging_app.plane_reader
    lspr_imaging_app.shard_crc
    lspr_imaging_app.frame_naming
    lspr_imaging_app.export_stats
    lspr_imaging_app.analysis.check_report
    lspr_imaging_app.analysis.export_tables
    lspr_imaging_app.analysis.fit_window
    lspr_imaging_app.analysis.frame_reduce
    lspr_imaging_app.analysis.gaussian_fit
    lspr_imaging_app.analysis.image_motion
    lspr_imaging_app.analysis.metric_range
    lspr_imaging_app.analysis.order_quality
    lspr_imaging_app.analysis.provenance
    lspr_imaging_app.analysis.query
    lspr_imaging_app.analysis.reduction
    lspr_imaging_app.analysis.response_shape
    lspr_imaging_app.analysis.scan
    lspr_imaging_app.analysis.scan_arrays
    lspr_imaging_app.analysis.scan_fingerprint
    lspr_imaging_app.analysis.scan_jobs
    lspr_imaging_app.analysis.scan_mask_marks
    lspr_imaging_app.analysis.scan_pool
    lspr_imaging_app.analysis.scan_store
    lspr_imaging_app.analysis.settings
    lspr_imaging_app.analysis.spectrum_errors
    lspr_imaging_app.analysis.baseline_drift
    lspr_imaging_app.analysis.statistics
    lspr_imaging_app.analysis.step_diagnostics
    lspr_imaging_app.analysis.tasks
    lspr_imaging_app.analysis.template_shift
    lspr_imaging_app.analysis.trace_fit
