    lspr_imaging_app.image_tools.chromatic.model
    lspr_imaging_app.image_tools.chromatic.warp
    lspr_imaging_app.image_tools.chromatic.wavelength_interpolation
    lspr_imaging_app.image_tools.geometry.alignment
    lspr_imaging_app.image_tools.geometry.model
    lspr_imaging_app.image_tools.geometry.transform
    lspr_imaging_app.image_tools.mask.export
    lspr_imaging_app.image_tools.mask.io
    lspr_imaging_app.image_tools.mask.mask_pointers_state
